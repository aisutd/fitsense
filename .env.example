# Copy this file to .env (same folder) and fill in the values.
# .env is gitignored - never commit real credentials.
#
# Vite and Docker only read .env at startup: restart `npm run dev` /
# `docker compose up -d --force-recreate` after changing it.

# --- Backend: Supabase --------------------------------------------------------
# Supabase dashboard: Project Settings -> API Keys.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Use the *service_role* secret key (NOT the anon/public key).
# The profiles table has row level security enabled with no public policies,
# so only the service_role key can read/write it. Keep this key server-side only.
SUPABASE_KEY=
# --- Backend: USDA FoodData Central --------------------------------------------
# Optional. Foods come from the local USDA copy (python -m app.food.fdc_import, see README);
# with a key, anything missing from it is fetched from the FDC API and cached in fdc_foods.
# Free key: https://fdc.nal.usda.gov/api-key-signup (rate limited per key).
# Server-side only - never put it in a VITE_ variable.
FDC_API_KEY=

# --- Frontend (Vite) -----------------------------------------------------------
# Anything starting with VITE_ is bundled into the page and visible to anyone,
# so only public values go here. The app talks to Supabase through the backend;
# these are only needed by src/supabaseClient.js, which nothing imports right now.

# Same value as SUPABASE_URL
VITE_SUPABASE_URL=

# The *publishable* key (starts with sb_publishable_, or the legacy anon key)
VITE_SUPABASE_ANON_KEY=

# FitSense backend URL used by the frontend (optional, defaults to http://localhost:8000)
VITE_API_URL=
